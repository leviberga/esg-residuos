# Configurações Administrativas do Oracle
ORACLE_USERNAME:RM560489
ORACLE_PASSWORD=080205

# Configurações do Usuário da Aplicação (ESG)
APP_USER=esg_user
APP_USER_PASSWORD=esg_pass
a
# Configurações de Conexão Spring Boot
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@oracle-db:1521/XE
SPRING_DATASOURCE_USERNAME=esg_user
SPRING_DATASOURCE_PASSWORD=esg_pass

# Configurações do Pool de Conexões HikariCP
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1200000
SPRING_DATASOURCE_HIKARI_LEAK_DETECTION_THRESHOLD=60000

# Configurações de Memória e Performance (JVM)
JAVA_OPTS=-Xms256m -Xmx512m